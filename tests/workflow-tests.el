;;; workflow-tests.el --- Workspace, panel and file action checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'consult)
(require 'perspective)
(require 'help-mode)
(require 'compile)

(ert-deftest my-workspace-consult-and-modeline-follow-switches ()
  (let ((original (persp-current-name))
        (one (make-temp-name "workflow-one-"))
        (two (make-temp-name "workflow-two-"))
        (renamed (make-temp-name "workflow-renamed-"))
        (first (generate-new-buffer "workflow-first"))
        (second (generate-new-buffer "workflow-second")))
    (unwind-protect
        (save-window-excursion
          (persp-switch one)
          (switch-to-buffer first)
          (persp-add-buffer first)
          (persp-switch two)
          (switch-to-buffer second)
          (persp-add-buffer second)
          (dolist (entry (list (list one first second) (list two second first)))
            (persp-switch (car entry))
            (let* ((consult--buffer-query-cache nil)
                   (names (funcall (plist-get persp-consult-source :items))))
              (should (member (buffer-name (cadr entry)) names))
              (should-not (member (buffer-name (caddr entry)) names)))
            (should (string-match-p (regexp-quote (car entry))
                                    (doom-modeline-segment--my-workspace))))
          (persp-rename renamed)
          (should (string-match-p renamed (doom-modeline-segment--my-workspace)))
          ;; The global source remains available when narrowing with b SPC.
          (let* ((consult--buffer-query-cache nil)
                 (items (funcall (plist-get consult-source-buffer :items)))
                 (names (mapcar (lambda (entry) (if (consp entry) (car entry) entry))
                                 items)))
            (should (member (buffer-name first) names))
            (should (member (buffer-name second) names))))
      (persp-switch original)
      (dolist (name (list one two renamed))
        (when (member name (persp-names)) (persp-kill name)))
      (mapc (lambda (buffer) (when (buffer-live-p buffer) (kill-buffer buffer)))
            (list first second)))))

(ert-deftest my-auxiliary-panels-preserve-editor-windows-and-focus ()
  (let ((buffers (mapcar #'generate-new-buffer
                        '("workflow-editor-a" "workflow-editor-b"
                          "*workflow-help*" "*workflow-compile*"))))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (switch-to-buffer (nth 0 buffers))
          (let* ((editor (selected-window))
                 (other (split-window-right)))
            (set-window-buffer other (nth 1 buffers))
            (with-current-buffer (nth 2 buffers) (help-mode))
            (with-current-buffer (nth 3 buffers) (compilation-mode))
            (dolist (buffer (nthcdr 2 buffers))
              (pop-to-buffer buffer)
              (should (eq (window-parameter nil 'window-side) 'bottom))
              (should (< (window-total-height) (* (frame-height) 0.5)))
              (should (eq (window-buffer editor) (nth 0 buffers)))
              (should (eq (window-buffer other) (nth 1 buffers)))
              (quit-window)
              (should (eq (selected-window) editor)))))
      (mapc #'kill-buffer buffers))))

(ert-deftest my-file-actions-preserve-paths-and-unsaved-edits-on-rename ()
  (let* ((directory (make-temp-file "emacs-file-actions-" t))
         (default-directory (file-name-as-directory directory))
         (file (expand-file-name "before name.txt" directory))
         (destination (expand-file-name "after name.txt" directory))
         (kill-ring nil) (interprogram-cut-function nil)
         (select-enable-clipboard nil) buffer)
    (unwind-protect
        (progn
          (should (zerop (call-process "git" nil nil nil "init" "-q")))
          (with-temp-file file (insert "saved\n"))
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (my-copy-file-path)
            (should (equal (car kill-ring) file))
            (my-copy-project-file-path)
            (should (equal (car kill-ring) "before name.txt"))
            (goto-char (point-max))
            (insert "unsaved\n")
            (rename-visited-file destination)
            (should (equal buffer-file-name destination))
            (should (buffer-modified-p))
            (should (string-match-p "unsaved" (buffer-string)))
            (should (equal my-ui-title-project (file-name-nondirectory directory)))
            (should-not (file-exists-p file))
            (should (file-exists-p destination))
            (my-copy-project-file-path)
            (should (equal (car kill-ring) "after name.txt"))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest my-file-actions-finder-uses-literal-arguments-and-rejects-remote ()
  (skip-unless (eq system-type 'darwin))
  (let ((file (make-temp-file "finder spaced ' name")))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name file)
          (cl-letf (((symbol-function 'start-process)
                     (lambda (_name _buffer &rest command)
                       (should (equal command (list "/usr/bin/open" "-R" file))))))
            (my-reveal-in-finder))
          (setq buffer-file-name "/ssh:example.invalid:/repo/file.txt")
          (cl-letf (((symbol-function 'start-process)
                     (lambda (&rest _) (ert-fail "Tried to open a remote file"))))
            (should-error (my-reveal-in-finder) :type 'user-error)))
      (delete-file file))))

