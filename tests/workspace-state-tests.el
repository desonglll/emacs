;;; workspace-state-tests.el --- Durable workspace checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(ert-deftest my-workspace-snapshot-restores-files-and-window-layouts ()
  (let* ((directory (file-name-as-directory (make-temp-file "emacs-workspace-" t)))
         (my-state-directory directory)
         (persp-state-default-file (expand-file-name "workspaces.el" directory))
         (my-workspace-state-ready t)
         (one (make-temp-name "saved-one-"))
         (two (make-temp-name "saved-two-"))
         (original (persp-current-name))
         (files (mapcar (lambda (name) (expand-file-name name directory))
                       '("first.txt" "second.txt")))
         buffers)
    (unwind-protect
        (save-window-excursion
          (dolist (file files) (with-temp-file file (insert "workspace file\n")))
          (setq buffers (mapcar #'find-file-noselect files))
          (persp-switch one)
          (delete-other-windows)
          (switch-to-buffer (car buffers))
          (set-window-buffer (split-window-right) (cadr buffers))
          (persp-add-buffer (cadr buffers))
          (persp-switch two)
          (delete-other-windows)
          (switch-to-buffer (cadr buffers))
          (let ((noninteractive nil)) (my-workspace-save))
          (should (file-readable-p persp-state-default-file))
          (let ((noninteractive nil)) (my-workspace-save))
          (should (file-readable-p (concat persp-state-default-file ".bak")))
          (persp-switch original)
          (persp-kill one)
          (persp-kill two)
          (mapc #'kill-buffer buffers)
          (persp-state-load persp-state-default-file)
          (persp-switch one)
          (should (= (length (window-list)) 2))
          (should (equal (sort (mapcar (lambda (win) (buffer-file-name (window-buffer win)))
                                       (window-list)) #'string<)
                         (sort (copy-sequence files) #'string<)))
          (persp-switch two)
          (should (= (length (window-list)) 1))
          (should (equal buffer-file-name (cadr files))))
      (persp-switch original)
      (dolist (name (list one two))
        (when (member name (persp-names)) (persp-kill name)))
      (dolist (file files)
        (when-let ((buffer (get-file-buffer file))) (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest my-workspace-failed-save-preserves-previous-snapshot ()
  (let* ((directory (file-name-as-directory (make-temp-file "emacs-workspace-" t)))
         (my-state-directory directory)
         (persp-state-default-file (expand-file-name "workspaces.el" directory))
         (my-workspace-state-ready t))
    (unwind-protect
        (progn
          (with-temp-file persp-state-default-file (insert "original snapshot"))
          (cl-letf (((symbol-function 'persp-state-save)
                     (lambda (&rest _) (error "Simulated save failure")))
                    ((symbol-function 'display-warning) #'ignore))
            (let ((noninteractive nil)) (my-workspace-save)))
          (should (equal (with-temp-buffer
                           (insert-file-contents persp-state-default-file)
                           (buffer-string))
                         "original snapshot"))
          (should-not (directory-files directory nil "^\\.workspaces-")))
      (delete-directory directory t))))

(ert-deftest my-workspace-batch-mode-never-restores-or-saves ()
  (let ((noninteractive t)
        (my-workspace-state-ready t))
    (cl-letf (((symbol-function 'persp-state-save) (lambda (&rest _) (ert-fail "Batch save")))
              ((symbol-function 'persp-state-load) (lambda (&rest _) (ert-fail "Batch restore"))))
      (my-workspace-restore)
      (my-workspace-save))))

;;; workspace-state-tests.el ends here
