;;; format-policy-tests.el --- Unified automatic formatting checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'format-all)

(ert-deftest my-format-toggle-and-native-mode-control-java-and-rust ()
  (dolist (mode '(java-ts-mode rust-ts-mode))
    (with-temp-buffer
      (setq major-mode mode)
      (setq-local lsp-mode t)
      (format/prepare-on-save)
      (let ((calls 0))
        (cl-letf (((symbol-function 'lsp-feature?) (lambda (_) t))
                  ((symbol-function 'lsp-format-buffer) (lambda () (cl-incf calls))))
          (run-hooks 'before-save-hook)
          (should (= calls 1))
          (my-toggle-format-on-save)
          (run-hooks 'before-save-hook)
          (should (= calls 1))
          (my-toggle-format-on-save)
          (run-hooks 'before-save-hook)
          (should (= calls 2))
          (format-all-mode -1)
          (run-hooks 'before-save-hook)
          (should (= calls 2))
          ;; Manual formatting stays available while automatic formatting is off.
          (format/region-or-buffer)
          (should (= calls 3))
          (format-all-mode 1)
          (run-hooks 'before-save-hook)
          (should (= calls 4)))))))

(ert-deftest my-format-project-opt-out-survives-first-and-later-saves ()
  (let* ((directory (file-name-as-directory (make-temp-file "format-policy-" t)))
         (default-directory directory)
         (my-lsp-language-clients nil))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name ".dir-locals.el")
            (insert "((nil . ((my-format-on-save . nil))))"))
          (dolist (file '("example.el" "Example.java" "example.rs"))
            (with-current-buffer (find-file-noselect (expand-file-name file))
              (should-not my-format-on-save)
              (setq-local lsp-mode t)
              (cl-letf (((symbol-function 'lsp-feature?) (lambda (_) t))
                        ((symbol-function 'lsp-format-buffer)
                         (lambda () (ert-fail "Project opted out of LSP formatting")))
                        ((symbol-function 'format-all--run-chain)
                         (lambda (&rest _) (ert-fail "Project opted out of formatting"))))
                (insert "// unchanged indentation\n")
                (save-buffer)
                (insert "// second save\n")
                (save-buffer)))))
      (dolist (buffer (buffer-list))
        (when-let ((file (buffer-file-name buffer)))
          (when (string-prefix-p directory file)
            (with-current-buffer buffer (set-buffer-modified-p nil))
            (kill-buffer buffer))))
      (delete-directory directory t))))

(ert-deftest my-format-toggle-restarts-normal-formatter-once ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "(progn\n(message \"one\"))\n")
    (my-toggle-format-on-save)
    (run-hooks 'before-save-hook)
    (should (string-match-p "\n(message" (buffer-string)))
    (my-toggle-format-on-save)
    (run-hooks 'before-save-hook)
    (should (string-match-p "\n  (message" (buffer-string)))
    (should format-all-mode)
    ;; Directory-local opt-out also works after the backend has initialized.
    (setq my-format-on-save nil)
    (erase-buffer)
    (insert "(progn\n(message \"two\"))\n")
    (run-hooks 'before-save-hook)
    (should (string-match-p "\n(message" (buffer-string)))))

(ert-deftest my-format-skips-buffer-that-grew-after-formatter-started ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (format-all-mode 1)
    (let ((my-large-buffer-threshold 32))
      (insert (make-string 64 ?x))
      (cl-letf (((symbol-function 'format-all--run-chain)
                 (lambda (&rest _) (ert-fail "Formatted a large buffer"))))
        (run-hooks 'before-save-hook)))))

;;; format-policy-tests.el ends here
